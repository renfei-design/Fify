{
  "mcpServers": {
    "fify": {
      "command": "./scripts/launch_fify_mcp",
      "args": ["./server/dist/server.mjs"],
      "cwd": ".",
      "env_vars": [
        "CODEX_MCP_NODE_PATH",
        "CODEX_BROWSER_USE_NODE_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH",
        "CODEX_CLI_PATH",
        "FIFY_PROFILE_MEDIA_LOOKUP",
        "XDG_CACHE_HOME",
        "HOME",
        "USERPROFILE",
        "LOCALAPPDATA",
        "PATH"
      ],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 120
    }
  }
}
