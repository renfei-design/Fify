{
  "name": "@fify/mcp-app",
  "version": "0.1.0",
  "private": true,
  "description": "Installable MCP Apps server and inline information UI for Fify.",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": "./dist/server.js",
    "./http": "./dist/http.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/plugin-entry.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/plugin-server.mjs --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "start": "node dist/plugin-entry.js",
    "preview": "node scripts/preview.mjs",
    "preview:comparison": "node scripts/comparison-preview.mjs",
    "preview:briefing": "node scripts/briefing-preview.mjs",
    "preview:interactions": "node scripts/interaction-preview.mjs",
    "preview:catalog": "node scripts/catalog-preview.mjs"
  },
  "dependencies": {
    "@fify/a2ui": "workspace:*",
    "@fify/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
