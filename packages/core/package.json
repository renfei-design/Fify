{
  "name": "@fify/core",
  "version": "0.1.0",
  "description": "Supported Fify facade for validating grounded information and compiling it to trusted A2UI.",
  "author": "Fify Contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renfei-design/Fify.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "fify": {
    "stability": "supported-prerelease"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./openai": "./dist/openai.js",
    "./provider": "./dist/provider.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@fify/a2ui": "workspace:*",
    "zod": "^4.3.6"
  }
}
